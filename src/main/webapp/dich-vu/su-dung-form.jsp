<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ghi nhận dịch vụ | QLKhachSan</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"><style>.wrap{max-width:1250px;margin:0 auto;padding:28px}.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}.table-wrap{overflow:auto;background:#fff;border:1px solid #e5eaf1;border-radius:12px}table{width:100%;border-collapse:collapse;min-width:650px}th,td{padding:13px 15px;text-align:left;border-bottom:1px solid #edf0f5}th{font-size:12px;text-transform:uppercase;letter-spacing:.4px;color:#718096;background:#f8fafc}td{font-size:13px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 18px;max-width:780px;background:white;padding:24px;border:1px solid #e5eaf1;border-radius:14px}.form-grid input,.form-grid select,.form-grid textarea{width:100%;padding:11px;border:1px solid #d8e0ea;border-radius:8px}.actions{display:flex;gap:8px;flex-wrap:wrap}.muted{color:#718096}@media(max-width:650px){.wrap{padding:15px}.form-grid{grid-template-columns:1fr}}</style></head><body><main class="wrap"><div class="bar"><div><div class="eyebrow">QLKhachSan / Quản lý</div><h1 style="font-size:25px;margin:5px 0">Ghi nhận dịch vụ sử dụng</h1><p class="muted">Quản lý dữ liệu kết nối với cơ sở dữ liệu khách sạn.</p></div><div class="actions"><a class="btn" href="${pageContext.request.contextPath}/">← Dashboard</a><a class="btn btn-primary" href="${pageContext.request.contextPath}/su-dung-dich-vu?action=new">＋ Thêm mới</a></div></div><c:if test="${not empty error}"><div class="error"><c:out value="${error}"/></div></c:if><form class="form-grid" method="post" action="${pageContext.request.contextPath}/su-dung-dich-vu"><label class="field"><span>Mã sử dụng (để trống khi thêm)</span><input name="maSuDungDichVu" value="${item.maSuDungDichVu}"></label><label class="field"><span>Đặt phòng</span><select name="maDatPhong" required><option value="">-- Chọn đặt phòng --</option><c:forEach var="dp" items="${datPhongs}"><option value="${dp.maDatPhong}" ${item.datPhong.maDatPhong == dp.maDatPhong ? 'selected' : ''}><c:out value="${dp.maDatPhong}"/> - <c:out value="${dp.khachHang.hoTen}"/></option></c:forEach></select></label><label class="field"><span>Dịch vụ</span><select name="maDichVu" required><option value="">-- Chọn dịch vụ --</option><c:forEach var="dv" items="${dichVus}"><option value="${dv.maDichVu}" ${item.dichVu.maDichVu == dv.maDichVu ? 'selected' : ''}><c:out value="${dv.tenDichVu}"/> - <c:out value="${dv.donGia}"/> VNĐ</option></c:forEach></select></label><label class="field"><span>Số lượng</span><input type="number" name="soLuong" min="1" value="${empty item.soLuong ? 1 : item.soLuong}" required></label><div class="actions" style="grid-column:1/-1"><button class="btn btn-primary">Lưu sử dụng dịch vụ</button><a class="btn" href="${pageContext.request.contextPath}/su-dung-dich-vu">Hủy</a></div></form></main><script src="${pageContext.request.contextPath}/js/shared-layout.js" defer></script></body></html>